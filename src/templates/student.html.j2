{% extends 'base.html.j2' %}

{% block title %}{{ student.student.user.firstname }} {{ student.subject.name }}{% endblock %}
{% block ogtitle %}{{ student.student.user.firstname }} {{ student.subject.name }}{% endblock %}

{% block cactive %}active{% endblock %}

{% block content %}

<div style="display: flex; align-items: center; width: 100%; flex-direction: column;">
  <a style="margin-top:20px;padding: 5px 20%;box-shadow: var(--shadow) 2px 2px 10px;border-radius: 15px;"
    href="/courses/{{ student.subject_id }}">Retour</a>
  <div class="visual_break">
    <h1 style="margin-bottom:0;">
      <a href="mailto:{{ student.student.user.email }}">
        {{ student.student.user.firstname }} {{ student.student.user.name }}
      </a>
    </h1>
    <i>{{ student.subject.name }}</i>
    <div style="margin:20px;">
      <label for="hide">Cacher le cours</label>
      <input style="min-width:0;" type="checkbox" name="hide" value="hide" id="hide" {% if student.hidden %}checked{%
        endif %}>
      <script>
        document.getElementById("hide").addEventListener("input", () => {
          fetch("/hide-course/{{ student.id }}?hide=" + document.getElementById("hide").checked, {
            method: "POST"
          });
        })
      </script>
    </div>
  </div>
  <div class="visual_break">
    <h1>Catégories :</h1>
    <div class="tile_container">
      {% for mod in student.modules %}
      <div>
        <div class="student_outer">
          <h2 style="margin:0;text-align:center;">{{ mod.subject.title }}</h2>

          <a href="/courses/{{ student.subject_id }}/{{ mod.student_course_id }}/{{ mod.id }}"
            style="padding: 5px 20%;box-shadow: var(--shadow) 2px 2px 10px;border-radius: 15px;text-align:center;margin-top:20px;">
            Voir les détails
          </a>
          {% for category in mod.categories|sort(attribute='category.title') %}
          <p><b>{{ category.category.title }} :</b></p>
          <div style="align-items:center; display:flex;">
            <label style="margin-top:0; width:30%;" for="progress">Progrès: <span id="span-cat-{{ category.id }}">{{
                category.progress }}</span>%</label>
            <progress value="{{ category.progress }}" max="100" {% if category.passed %}class="class-passed" {% endif
              %}></progress>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  <div class="visual_break">
    <h1>Commentaires :</h1>
    {% for comment in student.comments %}
    <div
      style="padding: 20px; border-radius: 40px; min-height: 40px; background-color: var(--background); margin: 20px 0; max-width: 400px; position: relative;">
      <p id="comment_{{ loop.index0 }}" style="margin:0; max-width: calc(100% - 45px);">{{ comment }}</p>
      <button class="delete_mod" id="del_{{ loop.index0 }}"
        style="border-radius: 5px 20px 20px 5px; height: calc(100% - 40px);">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          class="lucide lucide-trash">
          <path d="M10 11v6" />
          <path d="M14 11v6" />
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" />
          <path d="M3 6h18" />
          <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
        </svg>
      </button>
      <script>
        document.getElementById("del_{{ loop.index0 }}").addEventListener("click", () => {
          let ok = confirm("Voulez vous vraiment supprimer ce commentaire ? Cette action est finale et irreversible.");

          if (ok) {
            let form_data = new URLSearchParams();
            form_data.append("comment_id", "{{ loop.index0 }}");

            fetch(`/comments/{{ student.id }}`, {
              method: "DELETE",
              body: form_data
            }).then((res) => {
              if (res.status === 200) {
                window.location.reload();
              } else {
                alert(`Erreur ${res.status} en essayant de supprimer un commentaire`);
              }
            }).catch((e) => {
              alert(`Erreur ${e} en essayant de supprimer un commentaire`);
            });
          }
        });
      </script>
    </div>
    {% endfor %}
    <form action="/comments/{{ student.id }}" , method="post" id="form">
      <h2>Écrire un nouveau commentaire</h2>
      <span style="color: #ff0000; display:none;" id="span_forbidden">Le caractère '/' ne peut être utilisé</span>
      <textarea id="comment" name="comment" type="text" required autocomplete="off"
        style="min-width: calc(100% - 20px); padding: 10px; border-radius: 10px; border: 0px; box-shadow: inset var(--shadow) 5px 5px 10px; max-width: calc(100% - 20px); background-color: var(--background-2)"></textarea>
      <input type="submit" class="button" id="submit_comment" value="Commenter">
    </form>
    <script>
      let comment_box = document.getElementById("comment");
      let sub_comment = document.getElementById("submit_comment");
      let span_forbidden = document.getElementById("span_forbidden");

      comment_box.addEventListener("input", () => {
        sub_comment.disabled = comment_box.value.includes("/");
        span_forbidden.style.display = comment_box.value.includes("/") ? "block" : "none";
      });
    </script>
  </div>
</div>

{% endblock %}