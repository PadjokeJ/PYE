{% extends 'base.html.j2' %}

{% block title %}{{ student.student.user.firstname }} {{ student.subject.name }}{% endblock %}
{% block ogtitle %}{{ student.student.user.firstname }} {{ student.subject.name }}{% endblock %}

{% block cactive %}active{% endblock %}

{% block content %}

<div style="display: flex; align-items: center; width: 100%; flex-direction: column;">
  <a style="margin-top:20px;padding: 5px 20%;box-shadow: var(--shadow) 2px 2px 10px;border-radius: 15px;"
    href="/courses/{{ student.subject_id }}">Back</a>
  <h1 style="margin-bottom:0;">{{ student.student.user.firstname }} {{ student.student.user.name }}</h1>
  <i>{{ student.subject.name }}</i>
  <div style="margin:20px;">
    <label for="hide">Cacher le cours</label>
    <input style="min-width:0;" type="checkbox" name="hide" value="hide" id="hide" {% if student.hidden %}checked{%
      endif %}>
    <script>
      document.getElementById("hide").addEventListener("input", () => {
        fetch("/hide-course/{{ student.id }}?hide=" + document.getElementById("hide").checked, {
          method: "POST"
        });
      })
    </script>
  </div>
  <div class="tile_container">
    {% for mod in student.modules %}
    <div>
      <div class="student_outer">
        <h2 style="margin:0;text-align:center;">{{ mod.subject.title }}</h2>

        <a href="/courses/{{ student.subject_id }}/{{ mod.student_course_id }}/{{ mod.id }}"
          style="padding: 5px 20%;box-shadow: var(--shadow) 2px 2px 10px;border-radius: 15px;text-align:center;margin-top:20px;">Voir les détails</a>
        {% for category in mod.categories|sort(attribute='category.title') %}
        <p><b>{{ category.category.title }} :</b></p>
        <div style="align-items:center; display:flex;">
          <label style="margin-top:0; width:30%;" for="progress">Progrès: <span id="span-cat-{{ category.id }}">{{
              category.progress }}</span>%</label>
          <progress value="{{ category.progress }}" max="100" {% if category.passed %}class="class-passed" {% endif
            %}></progress>
        </div>
        {% endfor %}
      </div>
    </div>
    <script>
      document.getElementById("progress-{{ mod.id }}").addEventListener("input", () => {
        document.getElementById("span-{{ mod.id }}").innerHTML = document.getElementById("progress-{{ mod.id }}").value;
      });
    </script>
    {% endfor %}
  </div>
</div>

{% endblock %}