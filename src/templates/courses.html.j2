{% extends 'base.html.j2' %}

{% block title %}Cours{% endblock %}
{% block ogtitle %}Cours{% endblock %}

{% block cactive %}active{% endblock %}

{% block content %}
<div style="display: flex; align-items: center; width: 100%; flex-direction: column;">
  <h1 style="margin: 25px 0 0 0;">{% if current_user.type == "Parent" %}Les{% else %}Mes{% endif %} cours :</h1>
  <ul class="course">
    {% for c in courses %}
    <li class="course">
      <a href="/courses/{{ c.id }}"
        style="padding: 9px 50px;border-radius: 20px;box-shadow: #{{ "%0.6x" % c.color }} 0 0 10px; background-color: var(--background);color:#{{ "%0.6x" % c.color }};font-weight:bolder; margin: 10px 0;">
        {{ c.name }} -- {{ c.grade }}
      </a>
    </li>
    {% endfor %}
  </ul>
</div>
{% endblock %}