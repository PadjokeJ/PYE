{% extends 'base.html.j2' %}

{% block title %}Cours -- {{ course.name }}{% endblock %}
{% block ogtitle %}Cours -- {{ course.name }}{% endblock %}

{% block cactive %}active{% endblock %}

{% block content %}
<div style="display:flex; justify-content:center; width:100%;">
  <div style="flex-direction: column;">
    
    {% if current_user.type == "Teacher" %}
    <div style="border-radius: 40px; box-shadow: var(--shadow) 2px 2px 10px; padding: 10px; display: flex; margin-bottom: 20px; width: min-content; margin-top:20px; align-items:center;">
      <input value="{{ course.name }}" type="text" id="title" style="color: #{{ "%0.6x" % course.color }}; font-size: 25px; padding: 5px 10px; min-width:0; width: 200px; border-radius: 20px 5px 5px 20px;">
      <p style="font-size:32px;margin: 0; color: #{{ "%0.6x" % course.color }};" id="grade">{{ course.grade }}</p>
      <input type="color" id="title-color" value="#{{ "%0.6x" % course.color }}" style="width: 40px; padding: 0; height: 40px; min-width:0; border-radius: 5px;">
      <input type="button" value="Ok" id="modify-color" class="button" style="width: 40px; height: 40px; min-width: 0; border-radius: 5px 20px 20px 5px;">
    </div>
    <script>
      document.getElementById("title-color").addEventListener("input", () => {
        let val = document.getElementById("title-color").value;
        document.getElementById("title").style.color = val;
        document.getElementById("grade").style.color = val;
      });

      document.getElementById("modify-color").addEventListener("click", () => {
        fetch("{{ request.base_url }}/title/" + String(document.getElementById("title-color").value).slice(1) + "/" + document.getElementById("title").value, {
          method: "POST"
        });
      });
    </script>
    {% else %}
    <h1 style="color: #{{ "%0.6x" % course.color }}" id="title">{{ course.name }} -- {{ course.grade }}</h1>
    {% endif %}
    <i class="left_grad">{{ course.teacher.user.name }} {{ course.teacher.user.firstname }}</i>

    <div style="flex-direction: column;">
      {% if current_user.type == "Teacher" %}
      <h2>Étudiants :</h2>
      <ul>
        {% for c in course.students %}
        {% if not c.hidden %}
        <li style="margin: 20px 0;">
          <a style="padding: 5px 50px;border-radius: 15px;box-shadow: var(--shadow) 2px 2px 10px; background-color: var(--background);"
            href="{{ request.base_url }}/{{ c.id }}">
            {{ c.student.user.firstname }} {{ c.student.user.name }}
          </a>
        </li>
        {% endif %}
        {% endfor %}
      </ul>
      <form id="form" method="post" action="/add-to-course/{{ course.id }}">
        <label style="margin-top: 0;" for="student">Ajouter un étudiant</label>
        <select id="student" name="student" required>
          {% for s in all_students %}
          <option value="{{ s.id }}">{{ s.user.firstname }} {{ s.user.name }}</option>
          {% endfor %}
        </select>
        <input id="submit" type="submit" name="submit" value="Ajouter l'étudiant">
      </form>
      <h2>Catégories :</h2>
      <form id="form" method="post" action="/add-course-module/{{ course.id }}">
        <h3>Ajouter une nouvelle catégorie pour {{ course.name }}</h3>
        <label style="margin-top: 0;" for="title">Titre</label>
        <input id="title" name="title" required>
        <input id="submit" type="submit" name="submit" value="Ajouter le module">
      </form>
      <h3>Liste des catégories</h3>
      <ul class="modules">
        {% for mod in course.modules|sort(attribute='title') %}
        <li class="module">
          <h3 style="text-align: center;">{{ mod.title }}</h3>
          <button class="delete_mod" id="del_mod_{{ mod.id }}" style="border-radius: 5px 20px 5px 5px"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash"><path d="M10 11v6"/><path d="M14 11v6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button>
          <ul style="padding:0;margin:0;">
            {% for category in mod.categories|sort(attribute='title') %}
            <li class="lsmodule">{{ category.title }} <button class="delete_mod" id="del_{{ category.id }}" style="border-radius: 5px 20px 20px 5px"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash"><path d="M10 11v6"/><path d="M14 11v6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button></li>
            {% endfor %}
          </ul>
          <form id="form" method="post" action="/add-module-category/{{ course.id }}/{{ mod.id }}">
            <h3>Créer un nouveau module pour <i>{{ mod.title }}</i></h2>
              <label style="margin-top: 0;" for="title">Titre</label>
              <input id="title" name="title" required>
              <input id="submit" type="submit" name="submit" value="Ajouter le module">
          </form>
        </li>
        <script>
          {% for category in mod.categories|sort(attribute='title') %}
          let del_{{ category.id }} = document.getElementById("del_{{ category.id }}");

          del_{{ category.id }}.addEventListener("click", () => {
            let ok = confirm("Voulez vous vraiment enlever ce module ? Cette action est finale et irreversible.");
            if (ok) {
              fetch("/del-module-category/{{ course.id }}/{{ mod.id }}/{{ category.id }}", {
                method: 'DELETE'
              }).then((res) => {
                if (res.status === 200) {
                  window.location.reload();
                } else {
                  alert(`Erreur ${res.status} en essayant de supprimer le module {{ category.title }}`);
                }
              }).catch((e) => {
                alert(`Erreur ${e} en essayant de supprimer le module {{ category.title }}`);
              });
            }
          });
          {% endfor %}
          let del_mod_{{ mod.id }} = document.getElementById("del_mod_{{ mod.id }}");
          del_mod_{{ mod.id }}.addEventListener("click", () => {
            let ok = confirm("Voulez vous vraiment enlever cette catégorie ? Cette action est finale et irreversible.");
            if (ok) {
              fetch("/del-module/{{ course.id }}/{{ mod.id }}", {
                method: 'DELETE'
              }).then((res) => {
                if (res.status === 200) {
                  window.location.reload();
                } else {
                  alert(`Erreur ${res.status} en essayant de supprimer la catégorie {{ mod.id }}`);
                }
              }).catch((e) => {
                alert(`Erreur "${e}" en essayant de supprimer la catégorie {{ mod.title }}`);
              });
            }
          });
        </script>
        {% endfor %}
      </ul>

      <h2>Étudiants précédents :</h2>
      <ul>
        {% for c in course.students %}
        {% if c.hidden %}
        <li style="margin: 20px 0;">
          <a style="padding: 5px 50px; border-radius: 15px; box-shadow: var(--shadow) 2px 2px 10px; background-color: var(--background);"
            href="{{ request.base_url }}/{{ c.id }}">
            {{ c.student.user.firstname }} {{ c.student.user.name }}
          </a>
        </li>
        {% endif %}
        {% endfor %}
      </ul>
      {% endif %}

      {% if current_user.type == "Student" or current_user.type == "Parent" %}
      {% for c in course.students %}
      {% if c.student.user.email == current_user.id or current_user.id == c.student.parent_email or current_user.id == c.student.parent2_email %}
      {% if c.comments|length > 0 %}
      <h2>Commentaires :</h2>
      <ul>
        {% for com in c.comments %}
        <li><i>{{ com }}</i></li>
        {% endfor %}
      </ul>
      {% endif %}
      <h2>Catégories :</h2>
      <div style="display: grid; grid-template-columns: auto auto;">
        {% for mod in c.modules %}
        {% if not mod.optional %}
        <div
          style="margin: 8px; padding: 20px; border-radius: 40px; box-shadow: var({% if mod.focussed %}--orange{% else %}--shadow{% endif %}) {% if mod.focussed %}0 0{% else %}4px 4px{% endif %} 20px">
          <h3 style="margin-top: 0;">{{ mod.subject.title }}{% if mod.passed %}: <i>réussi !</i>{% endif %}</h3>
          {% if mod.categories|length > 0 %}
          <div style="margin: 8px; padding: 10px; border-radius: 20px; box-shadow: var(--shadow) 4px 4px 20px">
            {% for category in mod.categories %}
            <div style="margin:5px;">
              {{ category.category.title }}{% if category.passed %} -- <i>réussi !</i>{% endif %}<br>
              <progress value="{{ category.progress }}" max="100" {% if category.passed %}class="class-passed" {% endif %}></progress>
              <p style="margin: 0;margin-left: 5px;">{% if category.passed %}{{ category.progress }}%{% endif %}</p>
            </div>
            {% endfor %}
          </div>
          {% endif %}
        </div>
        {% endif %}
        {% endfor %}
      </div>
      {% endif %}
      {% endfor %}
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}